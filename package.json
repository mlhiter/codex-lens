{
  "name": "codex-lens",
  "displayName": "Codex Lens",
  "description": "A VSCode extension that provides intelligent code explanations and insights",
  "version": "0.0.1",
  "publisher": "mlhiter",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:csharp",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:php",
    "onLanguage:ruby",
    "onLanguage:kotlin",
    "onLanguage:swift",
    "onLanguage:scala",
    "onLanguage:dart",
    "onLanguage:r",
    "onLanguage:julia",
    "onLanguage:lua",
    "onLanguage:perl",
    "onLanguage:shell",
    "onLanguage:powershell",
    "onLanguage:sql",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:vue",
    "onLanguage:react",
    "onLanguage:jsx",
    "onLanguage:tsx"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Codex Lens",
      "properties": {
        "codexLens.apiKey": {
          "type": "string",
          "default": "",
          "description": "The API key for the LLM service."
        },
        "codexLens.baseUrl": {
          "type": "string",
          "default": "",
          "description": "The base URL for the LLM service (e.g., 'https://api.anthropic.com')."
        },
        "codexLens.model": {
          "type": "string",
          "default": "claude-3-5-haiku-20241022",
          "description": "The model to use for code explanations (e.g., 'claude-3-5-haiku-20241022', 'gpt-4', 'gpt-3.5-turbo')."
        },
        "codexLens.maxTokens": {
          "type": "number",
          "default": 1000,
          "description": "Maximum number of tokens for the response."
        },
        "codexLens.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperature for the model response (0-2, where 0 is deterministic and 2 is very random)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.34.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "axios": "^1.12.2"
  }
}
